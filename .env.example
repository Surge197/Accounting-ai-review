# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key for GPT-4o / GPT-4o-mini review models.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ZOHO BOOKS INTEGRATION
ZOHO_CLIENT_ID="MY_ZOHO_CLIENT_ID"
ZOHO_CLIENT_SECRET="MY_ZOHO_CLIENT_SECRET"
ZOHO_ACCESS_TOKEN="MY_ZOHO_ACCESS_TOKEN"
ZOHO_DATA_CENTER="in"

# WINDOWS TALLY CONNECTOR (opt-in; configure an operator token before enabling)
CONNECTOR_ENABLED="false"
CONNECTOR_ADMIN_TOKEN=""
CONNECTOR_DB_PATH="./data/connector.sqlite"
# Local development only; never enable for production.
CONNECTOR_ALLOW_INSECURE_LOOPBACK="false"
# Set ONLY to the exact trusted TLS reverse-proxy IP/CIDR; restrict origin ingress too.
CONNECTOR_TRUST_PROXY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
